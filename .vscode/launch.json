{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start SBA Chits Fund Server",
            "program": "${workspaceFolder}/sba-chits-fund/server.js",
            "cwd": "${workspaceFolder}/sba-chits-fund",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Local URL : (https?://\\S+)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}/sba-chits-fund"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
