# =======================================================
# SBA CHITS & FUND PRIVATE LIMITED - Website Configuration
# =======================================================
# Copy this file to ".env" and fill in the real values.
# The .env file should NEVER be committed to version control.

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- Admin Notification Email ----
# This is where customer enrollment emails will be sent.
ADMIN_EMAIL=sbachitsfund@gmail.com

# ---- SMTP / Mail Sender Credentials ----
# Gmail is used by default. If you use Gmail you MUST create an
# "App Password" from Google Account -> Security -> 2-Step Verification -> App passwords.
# DO NOT use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sbachitsfund@gmail.com
SMTP_PASS=your-16-character-app-password-here
SMTP_FROM_NAME=SBA Chits & Fund - Website
